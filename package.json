{
  "name": "hubot-incoming-webhook",
  "version": "2.0.0",
  "description": "Accept incoming Webhooks to write messages to a room/channel",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "hooks"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=index.js --test-coverage-include='hooks/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100",
    "lint": "eslint ."
  },
  "keywords": [
    "hubot",
    "hubot-script"
  ],
  "authors": [
    "Kosmos Contributors <mail@kosmos.org>"
  ],
  "license": "MIT",
  "repository": "https://github.com/67P/hubot-incoming-webhook",
  "engines": {
    "node": ">= 22"
  },
  "peerDependencies": {
    "hubot": ">= 14"
  },
  "dependencies": {
    "he": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "hubot": "^14.1.0",
    "supertest": "^7.3.1"
  }
}
